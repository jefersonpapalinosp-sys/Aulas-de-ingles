# Variáveis exclusivas do serviço Compose no Easypanel. Nunca reutilize o .env
# de desenvolvimento e nunca versione os valores reais.

# Deve ser exatamente a origem primária configurada no domínio do serviço,
# sem barra final, caminho, query ou porta.
EASYPANEL_PUBLIC_ORIGIN=https://configure-domain.invalid

# O gerador local troca cada marcador por um valor aleatório independente.
EASYPANEL_DB_ADMIN_PASSWORD=GENERATE_HEX_32
EASYPANEL_MIGRATOR_PASSWORD=GENERATE_HEX_32
EASYPANEL_RUNTIME_PASSWORD=GENERATE_HEX_32
EASYPANEL_WORKER_PASSWORD=GENERATE_HEX_32
EASYPANEL_BACKUP_PASSWORD=GENERATE_HEX_32
EASYPANEL_JWT_SECRET=GENERATE_HEX_32
EASYPANEL_OPERATIONS_TOKEN=GENERATE_HEX_32

# Primeiro deploy: assistência remota desligada. O servidor não tem memória
# livre suficiente para hospedar com segurança o Ollama qwen2.5:7b junto da app.
EASYPANEL_ASSISTED_FEATURES_ENABLED=false
EASYPANEL_ASSIST_TRANSCRIPTION_URL=
EASYPANEL_ASSIST_WRITING_URL=
EASYPANEL_ASSIST_PROVIDER_TOKEN=

# JSON de IDs internos autorizados; [] bloqueia conversa assistida em prod/public.
EASYPANEL_DIALOGUE_PILOT_USER_IDS=[]
