# Variáveis exclusivas do serviço Compose no Easypanel. Nunca reutilize o .env
# de desenvolvimento e nunca versione os valores reais.

# Deve ser exatamente a origem primária configurada no domínio do serviço,
# sem barra final, caminho, query ou porta.
EASYPANEL_PUBLIC_ORIGIN=https://configure-domain.invalid

# IPs/CIDRs do Traefik observado pelo nginx, separados por vírgula.
# Obrigatório antes do deploy. Não usar toda a rede Docker ou 0.0.0.0/0.
EASYPANEL_TRUSTED_PROXY_CIDRS=

# O gerador local troca cada marcador por um valor aleatório independente.
EASYPANEL_DB_ADMIN_PASSWORD=GENERATE_HEX_32
EASYPANEL_MIGRATOR_PASSWORD=GENERATE_HEX_32
EASYPANEL_RUNTIME_PASSWORD=GENERATE_HEX_32
EASYPANEL_WORKER_PASSWORD=GENERATE_HEX_32
EASYPANEL_BACKUP_PASSWORD=GENERATE_HEX_32
EASYPANEL_JWT_SECRET=GENERATE_HEX_32
EASYPANEL_JWT_KEY_ID=legacy
EASYPANEL_JWT_PREVIOUS_KEY_ID=
EASYPANEL_JWT_PREVIOUS_SECRET=
EASYPANEL_JWT_PREVIOUS_VALID_UNTIL=
MIGRATION_LOCK_TIMEOUT_MS=5000
MIGRATION_STATEMENT_TIMEOUT_MS=300000
EASYPANEL_OPERATIONS_TOKEN=GENERATE_HEX_32

# Primeiro deploy: assistência remota desligada. O servidor não tem memória
# livre suficiente para hospedar com segurança o Ollama qwen2.5:7b junto da app.
EASYPANEL_ASSISTED_FEATURES_ENABLED=false
EASYPANEL_ASSIST_TRANSCRIPTION_URL=
EASYPANEL_ASSIST_WRITING_URL=
EASYPANEL_ASSIST_PROVIDER_TOKEN=

# JSON de IDs internos autorizados; [] bloqueia todas as modalidades assistidas em prod/public.
EASYPANEL_DIALOGUE_PILOT_USER_IDS=[]

# Somente após confirmação do plano Workers Free; piloto usa MAX_ATTEMPTS=1.
EASYPANEL_ASSIST_CLOUDFLARE_FREE_PLAN_CONFIRMED=false
EASYPANEL_ASSIST_PROVIDER_KIND=gateway
EASYPANEL_ASSIST_PROVIDER_NAME=external
EASYPANEL_ASSIST_JOB_MAX_ATTEMPTS=3
EASYPANEL_ASSIST_DIALOGUE_URL=
EASYPANEL_DIALOGUE_PRACTICE_ENABLED=false
EASYPANEL_LISTENING_ENABLED=false
EASYPANEL_LISTENING_NATIVE_ENABLED=false

# Quantidade total de processos API + worker; ajuste ao escalar réplicas.
DATABASE_PROCESS_BUDGET=3
DATABASE_CONNECTION_RESERVE=10
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
WORKER_STOP_GRACE_PERIOD=150s
