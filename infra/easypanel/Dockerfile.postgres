FROM public.ecr.aws/docker/library/postgres:16.15-alpine@sha256:e0e53cfa0884f3cc216a621033e4f38dceb49e52218ac77facc8e48f02973093

COPY infra/easypanel/postgres-init.sh /docker-entrypoint-initdb.d/10-aulas-roles.sh
COPY infra/easypanel/apply-grants.sh /opt/aulas/apply-grants.sh
COPY ops/roles_policy.sql /opt/aulas/roles_policy.sql

RUN sed -i 's/\r$//' /docker-entrypoint-initdb.d/10-aulas-roles.sh /opt/aulas/apply-grants.sh \
    && chmod 0555 /docker-entrypoint-initdb.d/10-aulas-roles.sh \
    /opt/aulas/apply-grants.sh \
    && chmod 0444 /opt/aulas/roles_policy.sql
