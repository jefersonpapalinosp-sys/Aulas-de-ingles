# Build do bundle, depois nginx servindo estático. Node não vai para runtime.
FROM public.ecr.aws/docker/library/node:24.22.0-alpine3.24@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM public.ecr.aws/docker/library/nginx:1.30.6-alpine3.24@sha256:dc06c17afbc08d6fe9fbe48159aa81459da2b56baddddc45002f1a68ef77e256 AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY security-headers.conf /etc/nginx/security-headers.conf
COPY api-proxy.conf /etc/nginx/api-proxy.conf
COPY --chmod=755 35-trusted-proxies.sh /docker-entrypoint.d/35-trusted-proxies.sh
COPY --chmod=755 40-retain-assets.sh /docker-entrypoint.d/40-retain-assets.sh
RUN apk add --no-cache brotli-libs=1.2.1-r0 \
    && sed -i 's/\r$//' /docker-entrypoint.d/35-trusted-proxies.sh /docker-entrypoint.d/40-retain-assets.sh \
    && sed -i '/^user /d' /etc/nginx/nginx.conf \
    && mkdir -p /var/lib/aulas-web \
    && chown -R 101:101 /var/cache/nginx /run /var/lib/aulas-web
USER 101:101
EXPOSE 80
