# Build do bundle, depois nginx servindo estático. Node não vai para runtime.
FROM public.ecr.aws/docker/library/node:24.22.0-alpine3.24 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM public.ecr.aws/docker/library/nginx:1.30.6-alpine3.24 AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY security-headers.conf /etc/nginx/security-headers.conf
COPY api-proxy.conf /etc/nginx/api-proxy.conf
COPY --chmod=755 40-retain-assets.sh /docker-entrypoint.d/40-retain-assets.sh
EXPOSE 80
