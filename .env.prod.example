# Produção local. Copie para .env.prod e troque o que está marcado.
# Diferente do .env de dev, aqui não há default para segredo: a stack
# recusa subir sem valor próprio.

POSTGRES_USER=aulas
POSTGRES_PASSWORD=TROQUE_ISTO
POSTGRES_DB=aulas_ingles
POSTGRES_HOST_PORT=5434

DATABASE_URL=postgresql+asyncpg://aulas:TROQUE_ISTO@db:5432/aulas_ingles
APP_ENV=prod
LOG_LEVEL=info

# Pelo menos 32 bytes. Gere com: openssl rand -hex 32
JWT_SECRET=TROQUE_ISTO_POR_32_BYTES_OU_MAIS_DE_VERDADE

# true só quando houver HTTPS na frente. Em localhost o cookie Secure
# simplesmente não é enviado, e o login para de funcionar.
COOKIE_SECURE=false

WEB_HOST_PORT=5181
