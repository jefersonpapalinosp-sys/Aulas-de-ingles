# Copie para .env antes do primeiro `make up`.
# Nenhum valor aqui é segredo real — é tudo ambiente local.

# --- Postgres (container) ---
POSTGRES_USER=aulas
POSTGRES_PASSWORD=aulas_local
POSTGRES_DB=aulas_ingles
# Porta exposta no host. 5432/5444/5456 já estão em uso por outros projetos.
POSTGRES_HOST_PORT=5433

# --- Backend ---
# Dentro do compose o host do banco é o nome do serviço: "db".
DATABASE_URL=postgresql+asyncpg://aulas:aulas_local@db:5432/aulas_ingles
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Compose atual: uma API + um worker. Ajuste junto com a quantidade de réplicas.
DATABASE_PROCESS_BUDGET=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
API_HOST_PORT=8010
APP_ENV=dev
LOG_LEVEL=info
# Sprint 38: HTTP local só em loopback. Perfil public exige HTTPS + cookie Secure.
DEPLOYMENT_PROFILE=local
COOKIE_SECURE=false
# PUBLIC_ORIGIN=https://seu-dominio (obrigatório no perfil public)
LEGACY_WRITES_UNTIL=2026-11-13T00:00:00Z
AUTH_IDENTITY_LIMIT=20
AUTH_ORIGIN_LIMIT=200
AUTH_WINDOW_SECONDS=300
AUTH_HASH_CONCURRENCY=2
# Opcional, 32+ bytes: separa os contadores de login do JWT_SECRET.
# AUTH_BUCKET_SECRET=
# Limite por gravação; o diretório é definido pelo volume do compose.
SPEAKING_MAX_BYTES=2000000

# --- Assistência experimental (desligada por padrão) ---
# Os endpoints apontam para um gateway privado que implemente o contrato JSON
# documentado em docs/avaliacao_sprint14_assistencia.md.
ASSISTED_FEATURES_ENABLED=false
ASSIST_TRANSCRIPTION_URL=
ASSIST_WRITING_URL=
ASSIST_PROVIDER_KIND=gateway
ASSIST_PROVIDER_NAME=external
ASSIST_PROVIDER_TOKEN=
ASSIST_OLLAMA_BASE_URL=http://host.docker.internal:11434
ASSIST_OLLAMA_MODEL=qwen2.5:7b
ASSIST_DAILY_QUOTA=5
ASSIST_RESERVATION_SECONDS=900
ASSIST_RETENTION_DAYS=30
ASSIST_TIMEOUT_SECONDS=20
ASSIST_JOB_MAX_ATTEMPTS=3
ASSIST_JOB_RETRY_BASE_SECONDS=5
ASSIST_JOB_STALE_SECONDS=120
ASSIST_WORKER_POLL_SECONDS=1
# Lotes independentes do acesso do aluno; transcrições/reservas sempre expiram.
MAINTENANCE_BATCH_SIZE=100
MAINTENANCE_INTERVAL_SECONDS=60
# Opt-in: refresh já expirado e pending vazio há mais de 7 dias; nunca apaga arquivos.
MAINTENANCE_CLEANUP_ENABLED=false

# --- Frontend ---
WEB_HOST_PORT=5180
# O browser fala com /api na mesma origem; o Vite faz o proxy para cá.
VITE_API_PROXY_TARGET=http://api:8000
# Sprint 40B.2a: habilitar somente após migration/permissões e ensaio isolado.
EDITORIAL_SNAPSHOTS_ENABLED=false
# Arquivamento auditado: somente ensaios locais, CLI no papel owner/migrador.
# Não propagado ao runtime nos composes; prod/public recusam mesmo se true.
EDITORIAL_ARCHIVE_ENABLED=false
# Reordenação auditada: somente ensaio local pelo papel owner/migrador.
# Não propagado ao runtime; prod/public permanecem recusados.
EDITORIAL_REORDER_ENABLED=false
# Diagnóstico agregado de SQL/latência/payload; a API recusa em prod/public.
PERFORMANCE_PROBE_ENABLED=false

# BE-47: sugestão de conversa no Hoje. Só ligar com FE-47 e revisão SEC-46.
DIALOGUE_PRACTICE_ENABLED=false
