    "info": {
        "title": "Aulas de Inglês — API",
        "version": "0.1.0"
    },
    "openapi": "3.1.0",
    "paths": {
        "/api/health": {
            "get": {
                "description": "Readiness.\n\nAbre uma conexão de verdade e pergunta a versão ao Postgres. Se o banco\nnão responder, devolve 503 — é isso que faz o healthcheck valer alguma coisa.",
                "operationId": "health_api_health_get",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthOut"
                                }
                            }
                        },
                        "description": "Successful Response"
                    }
                },
                "summary": "Health",
                "tags": [
                    "health"
                ]
            }
        },
        "/api/lessons": {
            "get": {
                "description": "Todas as aulas, em ordem, com o mínimo para montar a navegação.",
                "operationId": "listar_aulas_api_lessons_get",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/LessonSummaryOut"
                                    },
                                    "title": "Response Listar Aulas Api Lessons Get",
                                    "type": "array"
                                }
                            }
                        },
                        "description": "Successful Response"
                    }
                },
                "summary": "Listar Aulas",
                "tags": [
                    "lessons"
                ]
            }
        },
        "/api/lessons/{number}": {
            "get": {
                "description": "Uma aula inteira: gramática, frases, vocabulário, pronúncia e exercícios.",
                "operationId": "obter_aula_api_lessons__number__get",
                "parameters": [
                    {
                        "in": "path",
                        "name": "number",
                        "required": true,
                        "schema": {
                            "title": "Number",
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LessonDetailOut"
                                }
                            }
                        },
                        "description": "Successful Response"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        },
                        "description": "Validation Error"
                    }
                },
                "summary": "Obter Aula",
                "tags": [
                    "lessons"
                ]
            }
        },
        "/api/live": {
            "get": {
                "description": "Liveness: o processo está de pé. Não toca em dependência nenhuma.",
                "operationId": "live_api_live_get",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "additionalProperties": {
                                        "type": "string"
                                    },
                                    "title": "Response Live Api Live Get",
                                    "type": "object"
                                }
                            }
                        },
                        "description": "Successful Response"
                    }
                },
                "summary": "Live",
                "tags": [
                    "health"
                ]
            }
        },
        "/api/vocab": {
            "get": {
                "description": "Vocabulário de uma aula, ou de todas. Base do deck de revisão da S4.",
                "operationId": "listar_vocabulario_api_vocab_get",
                "parameters": [
                    {
                        "description": "Filtra por número da aula.",
                        "in": "query",
                        "name": "lesson",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "integer"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Filtra por número da aula.",
                            "title": "Lesson"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/VocabItemWithLessonOut"
                                    },
                                    "title": "Response Listar Vocabulario Api Vocab Get",
                                    "type": "array"
                                }
                            }
                        },
                        "description": "Successful Response"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        },
                        "description": "Validation Error"
                    }
                },
                "summary": "Listar Vocabulario",
                "tags": [
                    "lessons"
                ]
            }
        }
    }
}
