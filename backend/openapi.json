    "info": {
        "title": "Aulas de Inglês — API",
        "version": "0.1.0"
    },
    "openapi": "3.1.0",
    "paths": {
        "/api/auth/login": {
            "post": {
                "operationId": "entrar_api_auth_login_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginIn"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenOut"
                                }
                            }
                        },
                        "description": "Successful Response"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        },
                        "description": "Validation Error"
                    }
                },
                "summary": "Entrar",
                "tags": [
                    "auth"
                ]
            }
        },
        "/api/auth/logout": {
            "post": {
                "description": "Revoga a sessão de refresh e apaga o cookie.",
                "operationId": "sair_api_auth_logout_post",
                "responses": {
                    "204": {
                        "description": "Successful Response"
                    }
                },
                "summary": "Sair",
                "tags": [
                    "auth"
                ]
            }
        },
        "/api/auth/me": {
            "get": {
                "operationId": "quem_sou_eu_api_auth_me_get",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioOut"
                                }
                            }
                        },
                        "description": "Successful Response"
                    }
                },
                "summary": "Quem Sou Eu",
                "tags": [
                    "auth"
                ]
            }
        },
        "/api/auth/refresh": {
            "post": {
                "description": "Troca o refresh por um access novo. O refresh antigo é revogado.",
                "operationId": "renovar_api_auth_refresh_post",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenOut"
                                }
                            }
                        },
                        "description": "Successful Response"
                    }
                },
                "summary": "Renovar",
                "tags": [
                    "auth"
                ]
            }
        },
        "/api/auth/register": {
            "post": {
                "operationId": "registrar_api_auth_register_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegistroIn"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenOut"
                                }
                            }
                        },
                        "description": "Successful Response"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        },
                        "description": "Validation Error"
                    }
                },
                "summary": "Registrar",
                "tags": [
                    "auth"
                ]
            }
        },
        "/api/exercises": {
            "get": {
                "description": "Exercícios de uma aula, ou do bloco inteiro.\n\nÉ o que a prova do bloco consome: sem isso a tela teria que baixar as dez\naulas inteiras para montar uma lista de exercícios.",
                "operationId": "listar_exercicios_api_exercises_get",
                "parameters": [
                    {
                        "description": "Filtra por número da aula.",
                        "in": "query",
                        "name": "lesson",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "integer"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Filtra por número da aula.",
                            "title": "Lesson"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/ExerciseWithLessonOut"
                                    },
                                    "title": "Response Listar Exercicios Api Exercises Get",
                                    "type": "array"
                                }
                            }
                        },
                        "description": "Successful Response"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        },
                        "description": "Validation Error"
                    }
                },
                "summary": "Listar Exercicios",
                "tags": [
                    "lessons"
                ]
            }
        },
        "/api/exercises/{exercise_id}/answer": {
            "get": {
                "description": "Entrega o gabarito — só quando o usuário pede, e só se estiver logado.",
                "operationId": "revelar_resposta_api_exercises__exercise_id__answer_get",
                "parameters": [
                    {
                        "in": "path",
                        "name": "exercise_id",
                        "required": true,
                        "schema": {
                            "title": "Exercise Id",
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RevealAnswerOut"
                                }
                            }
                        },
                        "description": "Successful Response"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        },
                        "description": "Validation Error"
                    }
                },
                "summary": "Revelar Resposta",
                "tags": [
                    "progress"
                ]
            }
        },
        "/api/exercises/{exercise_id}/attempt": {
            "post": {
                "description": "Confere a resposta e grava a tentativa.\n\nA correção acontece aqui porque a resposta certa não faz parte do contrato\nde leitura: mandá-la ao navegador para o JavaScript comparar seria publicar\no gabarito. A comparação é a mesma de `app/domain/answers.py` — a regra\nmora num lugar só.",
                "operationId": "tentar_api_exercises__exercise_id__attempt_post",
                "parameters": [
                    {
                        "in": "path",
                        "name": "exercise_id",
                        "required": true,
                        "schema": {
                            "title": "Exercise Id",
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AttemptIn"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AttemptOut"
                                }
                            }
                        },
                        "description": "Successful Response"
                    },
                    "422": {
